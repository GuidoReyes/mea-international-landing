PORT=4000
FRONTEND_URL=http://localhost:3000

# Railway MySQL (auto-generated)
DATABASE_URL=mysql://user:password@host:port/database

# Railway Redis (auto-generated)
REDIS_URL=redis://default:password@host:port

# Auth
JWT_SECRET=

# Meta WhatsApp Business API
META_WHATSAPP_TOKEN=
META_PHONE_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Notion
NOTION_TOKEN=
NOTION_DATABASE_IDS=

# Admin / Notificaciones
ADMIN_WA_NUMBER=
ADMIN_EMAIL=

# Microsoft Graph (email transaccional)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Human Handoff — números de WhatsApp
MIRCE_PERSONAL_PHONE=50250191753
MIRCE_BOT_PHONE=50256311728

# ── Security Agent ────────────────────────────────────────────────────────────
# Required — dashboard access key (generate: openssl rand -hex 32)
SECURITY_DASHBOARD_SECRET=

# ── Backup — Google Drive ─────────────────────────────────────────────────────
# Option A: full JSON content as single env var (use on Railway)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: local path to JSON key file (use in local dev)
GOOGLE_SERVICE_ACCOUNT_PATH=
# Drive folder ID (from URL: drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# ── Pagos por depósito — Google Drive ─────────────────────────────────────────
# Folder ID de una carpeta "Pagos con depósito" ya creada y compartida con las
# mismas credenciales de Drive de arriba (GOOGLE_SERVICE_ACCOUNT_JSON/PATH o
# GOOGLE_OAUTH_*). Ahí se guardan las boletas subidas por los alumnos.
GOOGLE_DRIVE_PAGOS_FOLDER_ID=
# Retention counts (optional, defaults shown)
BACKUP_LOCAL_KEEP_COUNT=3
BACKUP_DRIVE_KEEP_COUNT=30
# Cron schedule (optional, default: 2 AM daily)
BACKUP_CRON=0 2 * * *

# ── Backup — Email Reports ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SECURITY_REPORT_EMAIL=

# ── TTS — Piper ────────────────────────────────────────────────────────────────
# Ruta al binario Piper y a la voz .onnx, instalados en el Dockerfile de producción
# (/opt/piper/piper y /opt/piper-voices/en_US-lessac-medium.onnx respectivamente).
# En local dev, instalá Piper manualmente y apuntá esta variable a tu voz descargada.
PIPER_VOICE_PATH=/opt/piper-voices/en_US-lessac-medium.onnx
