generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum InscripcionEstado {
  ACTIVA
  COMPLETADA
  CANCELADA
  SUSPENDIDA
}

enum PagoEstado {
  PENDIENTE
  COMPLETADO
  RECHAZADO
  REEMBOLSADO
  VENCIDO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  DEPOSITO
  OTRO
}

enum Moneda {
  GTQ
  USD
}

enum CategoriaEgreso {
  SALARIO
  COMISION
  OPERATIVO
  MARKETING
}

enum SuscripcionEstado {
  PENDIENTE
  ACTIVA
  CANCELADA
  VENCIDA
}

enum CampanaEstado {
  BORRADOR
  ENVIANDO
  COMPLETADA
}

enum DestinatarioEstado {
  PENDIENTE
  ENVIADO
  ERROR
}

// ─── CRM Pipeline ────────────────────────────────────────────────────────────

model CRMEtapa {
  id     Int    @id @default(autoincrement())
  nombre String
  orden  Int    @unique
  color  String @default("#00b4d8")
  leads  Lead[]
}

// ─── Core models ─────────────────────────────────────────────────────────────

model Lead {
  id                  Int                    @id @default(autoincrement())
  telefono            String                 @unique
  nombre              String?
  email               String?
  interes             String?
  estado              String                 @default("nuevo")
  etapaId             Int?
  etapa               CRMEtapa?              @relation(fields: [etapaId], references: [id])
  valorEstimado       Decimal?               @db.Decimal(10, 2)
  fechaCierreEstimada DateTime?
  notasCRM            String?                @db.Text
  asignadoAdminId     Int?
  asignadoAdmin       Admin?                 @relation(fields: [asignadoAdminId], references: [id])
  creadoEn            DateTime               @default(now())
  actualizadoEn       DateTime               @updatedAt
  conversaciones      ConversacionWhatsApp[]
  campanasDestinatario CampanaDestinatario[]
}

model Alumno {
  id              Int           @id @default(autoincrement())
  carnet          String        @unique
  nombre          String
  apellido        String
  // Registro dual: se exige AL MENOS UNO de email/whatsapp (regla de aplicación,
  // validada en los endpoints de registro — Prisma no soporta CHECK cross-column).
  email           String?       @unique
  whatsapp        String?       @unique
  fechaNacimiento DateTime?
  pais            String        @default("GT")
  activo          Boolean       @default(true)
  password        String?
  primerLogin     Boolean       @default(true)
  creadoEn        DateTime        @default(now())
  inscripciones   Inscripcion[]
  certificados    Certificado[]
  auditoria       AuditoriaAlumno[]
  inscripcionesOnline InscripcionOnline[]
  progresoLecciones   ProgresoLeccion[]
  suscripciones       Suscripcion[]
  certificadosOnline  CertificadoOnline[]
  reportesLeccion     ReporteLeccion[]
}

model Curso {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String    @db.Text
  precio      Decimal   @db.Decimal(10, 2)
  modalidad   String
  duracion    String
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now())
  ediciones   Edicion[]
}

model Edicion {
  id            Int           @id @default(autoincrement())
  cursoId       Int
  curso         Curso         @relation(fields: [cursoId], references: [id])
  nombre        String
  fechaInicio   DateTime
  fechaFin      DateTime
  precio        Decimal       @db.Decimal(10, 2)
  precioUSD     Decimal?      @db.Decimal(10, 2)
  cupo          Int           @default(20)
  activo        Boolean       @default(true)
  instructor    String?
  inscripciones Inscripcion[]
}

model Inscripcion {
  id          Int               @id @default(autoincrement())
  alumnoId    Int
  alumno      Alumno            @relation(fields: [alumnoId], references: [id])
  edicionId   Int
  edicion     Edicion           @relation(fields: [edicionId], references: [id])
  estado      InscripcionEstado @default(ACTIVA)
  creadoEn    DateTime          @default(now())
  pagos       Pago[]
  certificado Certificado?
}

model Pago {
  id            Int         @id @default(autoincrement())
  inscripcionId Int
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id])
  monto         Decimal     @db.Decimal(10, 2)
  montoUSD      Decimal?    @db.Decimal(10, 2)
  moneda        Moneda      @default(GTQ)
  metodo        MetodoPago
  estado        PagoEstado  @default(PENDIENTE)
  referencia    String?
  creadoEn      DateTime    @default(now())
  cuotas        CuotaPago[]
}

model CuotaPago {
  id          Int        @id @default(autoincrement())
  pagoId      Int
  pago        Pago       @relation(fields: [pagoId], references: [id])
  numeroCuota Int
  monto       Decimal    @db.Decimal(10, 2)
  fechaVence  DateTime
  estado      PagoEstado @default(PENDIENTE)
  pagadoEn    DateTime?
  abonos      Abono[]
}

model Abono {
  id          Int       @id @default(autoincrement())
  cuotaId     Int
  cuota       CuotaPago @relation(fields: [cuotaId], references: [id])
  monto       Decimal   @db.Decimal(10, 2)
  fecha       DateTime  @default(now())
  nota        String?
  creadoEn    DateTime  @default(now())

  @@index([cuotaId])
}

model Certificado {
  id            Int         @id @default(autoincrement())
  inscripcionId Int         @unique
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id])
  alumnoId      Int
  alumno        Alumno      @relation(fields: [alumnoId], references: [id])
  codigo        String      @unique
  urlPdf        String?
  urlQr         String?
  fechaEmision  DateTime    @default(now())
  revocado      Boolean     @default(false)
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────────

model ConversacionWhatsApp {
  id       Int               @id @default(autoincrement())
  leadId   Int?
  telefono String
  lead     Lead?             @relation(fields: [leadId], references: [id])
  mensajes MensajeWhatsApp[]
  estado   String            @default("activo")
  creadoEn DateTime          @default(now())
}

model MensajeWhatsApp {
  id             Int                  @id @default(autoincrement())
  conversacionId Int
  conversacion   ConversacionWhatsApp @relation(fields: [conversacionId], references: [id])
  rol            String
  contenido      String               @db.Text
  creadoEn       DateTime             @default(now())
}

// ─── Finanzas ────────────────────────────────────────────────────────────────

model Egreso {
  id        Int             @id @default(autoincrement())
  concepto  String
  monto     Decimal         @db.Decimal(10, 2)
  moneda    Moneda          @default(GTQ)
  categoria CategoriaEgreso
  fecha     DateTime
  nota      String?         @db.Text
  creadoEn  DateTime        @default(now())

  @@index([fecha])
}

// ─── Auditoría Alumno ────────────────────────────────────────────────────────

model AuditoriaAlumno {
  id       Int      @id @default(autoincrement())
  alumnoId Int
  alumno   Alumno   @relation(fields: [alumnoId], references: [id])
  accion   String
  detalle  String?  @db.Text
  adminId  Int?
  ip       String?
  creadoEn DateTime @default(now())

  @@index([alumnoId])
}

// ─── Campañas WhatsApp ────────────────────────────────────────────────────────

model CampanaWhatsApp {
  id                  Int                    @id @default(autoincrement())
  nombre              String
  template            String                 @db.Text
  variables           Json?
  estado              CampanaEstado          @default(BORRADOR)
  totalDestinatarios  Int                    @default(0)
  enviados            Int                    @default(0)
  errores             Int                    @default(0)
  creadoEn            DateTime               @default(now())
  actualizadoEn       DateTime               @updatedAt
  destinatarios       CampanaDestinatario[]
}

model CampanaDestinatario {
  id         Int                @id @default(autoincrement())
  campanaId  Int
  campana    CampanaWhatsApp    @relation(fields: [campanaId], references: [id])
  leadId     Int
  lead       Lead               @relation(fields: [leadId], references: [id])
  estado     DestinatarioEstado @default(PENDIENTE)
  error      String?
  enviadoEn  DateTime?

  @@index([campanaId])
  @@index([leadId])
}

// ─── Escalaciones ────────────────────────────────────────────────────────────

model EscalacionLog {
  id           Int       @id @default(autoincrement())
  telefono     String
  motivo       String    @db.Text
  resueltaEn   DateTime?
  resolvidaPor String?
  creadoEn     DateTime  @default(now())

  @@index([telefono])
}

// ─── Cursos Online (catálogo autoguiado, separado de Curso/Edicion por cohorte) ─

model CursoOnline {
  id            Int                 @id @default(autoincrement())
  slug          String              @unique
  titulo        String
  descripcion   String              @db.Text
  nivel         String              // "A1" | "A2" | "B1" | "B2" | "C1" | "general" | "oficios"
  track         String              // "general" | "oficina" | "mecanica" | "restaurantes"
  orden         Int                 @default(0)
  publicado     Boolean             @default(false)
  proximamente  Boolean             @default(false)
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt
  capitulos     Capitulo[]
  inscripciones InscripcionOnline[]
  certificados  CertificadoOnline[]
}

model Capitulo {
  id            Int         @id @default(autoincrement())
  cursoOnlineId Int
  cursoOnline   CursoOnline @relation(fields: [cursoOnlineId], references: [id])
  titulo        String
  nivel         String      @default("A1") // "A1".."C1"
  orden         Int
  lecciones     Leccion[]

  @@index([cursoOnlineId])
}

model Leccion {
  id           Int               @id @default(autoincrement())
  capituloId   Int
  capitulo     Capitulo          @relation(fields: [capituloId], references: [id])
  titulo       String
  slug         String
  urlContenido String?           // video, audio o markdown
  content      Json?             // LeccionContenido (LessonPlayer interactivo) — ver leccion-contenido.schema.ts
  orden        Int
  esGratis     Boolean           @default(false) // preview desbloqueada sin plan
  progreso     ProgresoLeccion[]
  rutas        RutaLeccion[]
  reportes     ReporteLeccion[]

  @@index([capituloId])
}

// Botón "algo funciona mal" dentro de LessonPlayer — el alumno reporta un
// problema puntual de la lección, queda como log para que el equipo lo revise
// y corrija (dia/hora = creadoEn, usuario = alumno, contenido = mensaje).
model ReporteLeccion {
  id        Int      @id @default(autoincrement())
  leccionId Int
  leccion   Leccion  @relation(fields: [leccionId], references: [id])
  alumnoId  Int
  alumno    Alumno   @relation(fields: [alumnoId], references: [id])
  mensaje   String
  resuelto  Boolean  @default(false)
  creadoEn  DateTime @default(now())

  @@index([leccionId])
  @@index([resuelto])
}

model InscripcionOnline {
  id            Int         @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno      @relation(fields: [alumnoId], references: [id])
  cursoOnlineId Int
  cursoOnline   CursoOnline @relation(fields: [cursoOnlineId], references: [id])
  iniciadaEn    DateTime    @default(now())

  @@unique([alumnoId, cursoOnlineId])
}

model ProgresoLeccion {
  id           Int       @id @default(autoincrement())
  alumnoId     Int
  alumno       Alumno    @relation(fields: [alumnoId], references: [id])
  leccionId    Int
  leccion      Leccion   @relation(fields: [leccionId], references: [id])
  completada   Boolean   @default(false)
  puntaje      Int?      // % acierto; certificado requiere promedio >= 85
  completadaEn DateTime?

  @@unique([alumnoId, leccionId])
}

model CertificadoOnline {
  id            Int         @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno      @relation(fields: [alumnoId], references: [id])
  cursoOnlineId Int
  cursoOnline   CursoOnline @relation(fields: [cursoOnlineId], references: [id])
  codigo        String      @unique
  puntaje       Int
  urlPdf        String?
  emitidoEn     DateTime    @default(now())

  @@unique([alumnoId, cursoOnlineId])
}

// ─── Rutas (curación/catálogo de lecciones, no reemplaza CursoOnline) ────────

model Ruta {
  id           Int           @id @default(autoincrement())
  slug         String        @unique
  titulo       String
  descripcion  String        @db.Text
  nivelMinimo  String
  nivelMaximo  String
  icono        String?
  orden        Int           @default(0)
  publicada    Boolean       @default(false)
  proximamente Boolean       @default(false)
  lecciones    RutaLeccion[]
}

model RutaLeccion {
  rutaId    Int
  ruta      Ruta    @relation(fields: [rutaId], references: [id])
  leccionId Int
  leccion   Leccion @relation(fields: [leccionId], references: [id])
  orden     Int     @default(0)

  @@id([rutaId, leccionId])
  @@index([leccionId])
}

// ─── Planes y Suscripciones ──────────────────────────────────────────────────

model Plan {
  id          Int          @id @default(autoincrement())
  nombre      String       // "Esencial" | "Profesional"
  slug        String       @unique
  descripcion String
  features    Json         // ["Cursos autoguiados", "Clases en vivo ilimitadas", ...]
  recomendado Boolean      @default(false)
  incluyeClasesEnVivo Boolean @default(false)
  precios     PlanPrecio[]
}

model PlanPrecio {
  id                    Int           @id @default(autoincrement())
  planId                Int
  plan                  Plan          @relation(fields: [planId], references: [id])
  duracionMeses         Int           // 1, 3, 6, 12
  precioMesCentavos     Int           // centavos para evitar floats
  precioTotalCentavos   Int
  precioRegularCentavos Int           // precio "tachado" antes de descuento
  moneda                Moneda        @default(GTQ)
  suscripciones         Suscripcion[]

  @@unique([planId, duracionMeses])
  @@index([planId])
}

model Suscripcion {
  id           Int               @id @default(autoincrement())
  alumnoId     Int
  alumno       Alumno            @relation(fields: [alumnoId], references: [id])
  planPrecioId Int
  planPrecio   PlanPrecio        @relation(fields: [planPrecioId], references: [id])
  estado       SuscripcionEstado @default(PENDIENTE)
  proveedor    String            // "manual_whatsapp" | "recurrente"
  idExterno    String?
  fechaInicio  DateTime?
  fechaFin     DateTime?
  creadoEn     DateTime          @default(now())
  pagos        PagoSuscripcion[]

  @@index([alumnoId])
}

model PagoSuscripcion {
  id                 Int         @id @default(autoincrement())
  suscripcionId      Int
  suscripcion        Suscripcion @relation(fields: [suscripcionId], references: [id])
  montoCentavos      Int
  moneda             Moneda      @default(GTQ)
  estado             PagoEstado  @default(PENDIENTE)
  proveedor          String
  idExterno          String?
  comprobanteUrl     String?
  comprobanteDriveId String?
  mesPagado          String?
  pagadoEn           DateTime?
  creadoEn           DateTime    @default(now())

  @@index([suscripcionId])
}

// ─── Clases en vivo (grupos recurrentes semanales) ───────────────────────────

model GrupoClaseEnVivo {
  id              Int            @id @default(autoincrement())
  slug            String         @unique
  nombre          String
  audiencia       String         // "ninos" | "adolescentes" | "adultos" | "general"
  niveles         String         // "A1" | "A2" | "B2,C1" | "PRE_A1" | "PRE_BEGINNERS" | "A1,A2"
  descripcion     String?        @db.Text
  profesor        String?
  urlZoom         String
  duracionMinutos Int            @default(60)
  activo          Boolean        @default(true)
  horarios        HorarioClase[]
}

model HorarioClase {
  id         Int              @id @default(autoincrement())
  grupoId    Int
  grupo      GrupoClaseEnVivo @relation(fields: [grupoId], references: [id])
  diaSemana  Int              // 0=domingo .. 6=sábado
  horaInicio String           // "HH:mm" 24h, hora de Guatemala

  @@unique([grupoId, diaSemana, horaInicio])
}

// ─── Admin ────────────────────────────────────────────────────────────────────

// Códigos OTP para registro/login por WhatsApp. El código se guarda hasheado
// (bcrypt) — nunca en texto plano. Expira a los 10 minutos.
model OtpCode {
  id         Int      @id @default(autoincrement())
  whatsapp   String
  codigoHash String
  expiraEn   DateTime
  usado      Boolean  @default(false)
  creadoEn   DateTime @default(now())

  @@index([whatsapp, usado])
}

model Admin {
  id        Int              @id @default(autoincrement())
  email     String           @unique
  password  String
  nombre    String
  rol       String           @default("ADMIN")
  activo    Boolean          @default(true)
  creadoEn  DateTime         @default(now())
  auditoria AuditoriaAdmin[]
  leads     Lead[]
}

model AuditoriaAdmin {
  id       Int      @id @default(autoincrement())
  adminId  Int
  admin    Admin    @relation(fields: [adminId], references: [id])
  accion   String
  recurso  String
  detalle  String?  @db.Text
  ip       String?
  creadoEn DateTime @default(now())
}
